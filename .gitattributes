# 统一换行符：源码/文档以 LF 存库，避免 Windows CRLF 造成的全文件 diff
* text=auto eol=lf

# 二进制资源：禁止文本规范化与 diff（否则会损坏文件 / 编辑器和 Git 都会误判）
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.bmp   binary
*.heic  binary
*.wasm  binary
*.onnx  binary
*.tflite binary
*.task  binary
*.zip   binary
*.7z    binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary

# 统计里不把生成产物算进语言占比
app.js  linguist-generated
models/** linguist-vendored
